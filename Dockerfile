# syntax=docker/dockerfile:1.7
#
# Lobby container images. One Dockerfile, two targets:
#   docker build --target web    -t lobby/web:local .
#   docker build --target worker -t lobby/worker:local .
# deploy/docker-compose.yml builds both for you (`docker compose up -d --build`).
#
# Both images run deploy/docker/migrate.mjs before their command, so the database schema is
# always current. The migrator takes a Postgres advisory lock, so starting web and worker
# together is safe.
#
# If you add a workspace package, add its package.json to the `manifests` stage below.

ARG NODE_IMAGE=node:24-alpine

# ---------------------------------------------------------------------------------------------
# base: Node with pnpm (version pinned by "packageManager" in package.json, via corepack).
FROM ${NODE_IMAGE} AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1 \
    CI=1
RUN corepack enable
WORKDIR /app

# ---------------------------------------------------------------------------------------------
# manifests: only the files pnpm needs to resolve dependencies, so source edits keep the
# install layer cached.
FROM base AS manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/ai/package.json packages/ai/
COPY packages/config/package.json packages/config/
COPY packages/connectors/package.json packages/connectors/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
RUN corepack install

# ---------------------------------------------------------------------------------------------
# web-build: full install (the build needs dev dependencies), then `next build`, which writes a
# self-contained server to apps/web/.next/standalone (output: "standalone" in next.config.ts).
FROM manifests AS web-build
RUN --mount=type=cache,id=lobby-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --store-dir /pnpm/store
COPY . .
RUN pnpm --filter @lobby/web build

# ---------------------------------------------------------------------------------------------
# worker-deps: production dependencies of the worker and the workspace packages it uses, plus
# @lobby/config so configuration as code can run inside the worker container.
# tsx is a production dependency of the worker, so TypeScript runs as-is, like in development.
FROM manifests AS worker-deps
RUN --mount=type=cache,id=lobby-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --store-dir /pnpm/store \
      --filter "@lobby/worker..." --filter "@lobby/config..."

# ---------------------------------------------------------------------------------------------
# migrator: drizzle-orm and postgres at exactly the versions packages/db declares, in their own
# node_modules, so migrate.mjs works the same in both images whatever their layout.
FROM ${NODE_IMAGE} AS migrator
WORKDIR /opt/lobby/migrate
COPY packages/db/package.json /tmp/db-package.json
RUN set -eu; \
    drizzle="$(node -p "require('/tmp/db-package.json').dependencies['drizzle-orm']")"; \
    pg="$(node -p "require('/tmp/db-package.json').dependencies['postgres']")"; \
    echo '{"name":"lobby-migrate","private":true}' > package.json; \
    npm install --omit=dev --no-audit --no-fund --loglevel=error "drizzle-orm@${drizzle}" "postgres@${pg}"; \
    npm cache clean --force >/dev/null 2>&1
COPY deploy/docker/migrate.mjs deploy/docker/seed-demo.mjs ./
# Generated by the integrator with `pnpm --filter @lobby/db generate`. The build fails here,
# on purpose, if they are missing: an image that cannot create its own schema is not shippable.
COPY packages/db/migrations /opt/lobby/migrations

# ---------------------------------------------------------------------------------------------
# web: the Next.js standalone server, running as the unprivileged `node` user.
FROM ${NODE_IMAGE} AS web
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    LOBBY_DATA_DIR=/data \
    LOBBY_MIGRATIONS_DIR=/opt/lobby/migrations \
    LOBBY_HEALTH_PATH=/api/health
WORKDIR /app
COPY --from=migrator /opt/lobby /opt/lobby
COPY --chmod=0755 deploy/docker/entrypoint.sh /usr/local/bin/lobby-entrypoint
# With outputFileTracingRoot at the repo root, the standalone server lives at apps/web/server.js.
COPY --from=web-build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=web-build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=web-build --chown=node:node /app/apps/web/public ./apps/web/public
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
EXPOSE 3000
VOLUME ["/data"]
# Any answer below 500 means the server is up and rendering. A redirect (for example to the
# setup wizard on a fresh install) counts as healthy.
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+(process.env.LOBBY_HEALTH_PATH||'/sign-in'),{redirect:'manual'}).then(r=>process.exit(r.status<500?0:1),()=>process.exit(1))"
ENTRYPOINT ["lobby-entrypoint"]
CMD ["node", "apps/web/server.js"]

# ---------------------------------------------------------------------------------------------
# worker: background jobs (email, search indexing, SLA timers, journeys, digests).
# Also carries the demo seed (packages/db/src/seed and deploy/demo/people.json) for seed-demo.
FROM ${NODE_IMAGE} AS worker
ENV NODE_ENV=production \
    LOBBY_DATA_DIR=/data \
    LOBBY_MIGRATIONS_DIR=/opt/lobby/migrations \
    LOBBY_APP_ROOT=/app
WORKDIR /app
COPY --from=migrator /opt/lobby /opt/lobby
COPY --chmod=0755 deploy/docker/entrypoint.sh /usr/local/bin/lobby-entrypoint
COPY --from=worker-deps /app ./
COPY packages ./packages
COPY apps/worker ./apps/worker
COPY deploy/demo/people.json ./deploy/demo/people.json
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
WORKDIR /app/apps/worker
ENTRYPOINT ["lobby-entrypoint"]
CMD ["node", "--import", "tsx", "src/index.ts"]
