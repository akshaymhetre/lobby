{
  "name": "@lobby/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "tsx src/ensure-extensions.ts && drizzle-kit push --force",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "reset": "tsx src/reset.ts && pnpm push && tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo no tests",
    "seed:one": "tsx src/seed/one.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
