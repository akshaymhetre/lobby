{
  "name": "@lobby/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search": "./src/search/index.ts",
    "./apps": "./src/apps/index.ts",
    "./home": "./src/home/index.ts",
    "./people": "./src/people/index.ts",
    "./knowledge": "./src/knowledge/index.ts",
    "./helpdesk": "./src/helpdesk/index.ts",
    "./journeys": "./src/journeys/index.ts",
    "./admin": "./src/admin/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:counts": "tsx --env-file-if-exists=../../apps/web/.env.local scripts/check-counts.ts"
  },
  "dependencies": {
    "@lobby/db": "workspace:*",
    "openid-client": "6.8.8",
    "pg-boss": "12.38.0",
    "zod": "4.6.7",
    "nodemailer": "^7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "@types/nodemailer": "^7"
  }
}
