# Lobby configuration for docker compose.
#
# Create your own copy with ./deploy/setup.sh. It fills in strong random secrets and the right
# values for your address. Edit deploy/.env afterwards to change anything, then run
# `docker compose up -d` again from the deploy folder.
#
# Never commit deploy/.env. It holds the keys to your database and your encrypted settings.
# Everything not listed here (company name, identity provider, apps, AI) lives in the database
# and is set in the setup wizard or under Admin.

# --- Which services run ---------------------------------------------------------------------
# app        the Lobby containers (web, worker, caddy). Always on for a real install.
# demo-idp   a demo identity provider with a fictional company, plus a mail catcher
# demo-apps  two demo apps (Grafana, Expenses) that sign in through the demo identity provider
# demo-seed  loads the demo company into an empty database, once
# A blank install uses just `app`. The demo uses app,demo-idp,demo-apps,demo-seed.
COMPOSE_PROFILES=app

# --- Address -------------------------------------------------------------------------------
# The URL people type to reach Lobby, without a trailing slash. Every sign-in redirect, email
# link and SCIM base URL is built from it, so it must match what your identity provider has.
LOBBY_URL=http://localhost:4100

# What Caddy (the built-in web server) answers on.
#   A domain such as lobby.example.com: Caddy gets a free HTTPS certificate from Let's Encrypt
#   and renews it. DNS for the domain must point at this machine and ports 80 and 443 must be open.
#   :80 for a local install on plain HTTP (LOBBY_HTTP_PORT then picks the port on your machine).
LOBBY_SITE_ADDRESS=:80

# Which network interface and ports Caddy publishes on this machine.
# 127.0.0.1 keeps a local install private to this computer; 0.0.0.0 accepts connections from anywhere.
LOBBY_BIND_ADDRESS=127.0.0.1
LOBBY_HTTP_PORT=4100
LOBBY_HTTPS_PORT=4443

# --- Secrets -------------------------------------------------------------------------------
# At least 32 random characters. Encrypts stored secrets (identity provider and AI keys) and
# signs session tokens. If you change it, every stored secret becomes unreadable and has to be
# entered again, so back it up together with the database.
LOBBY_SECRET=

# One-time token the setup wizard asks for before it creates the first administrator, so nobody
# else can claim a fresh install that is reachable on the internet. Not needed on localhost.
LOBBY_SETUP_TOKEN=

# Password for the bundled Postgres. It is applied only when the database volume is first
# created; changing it later does not change the password inside an existing database.
POSTGRES_PASSWORD=

# Postgres is published on this port, on 127.0.0.1 only, for backups and admin tools.
POSTGRES_PORT=4132

# Administrator password for the demo identity provider's admin console (demo-idp only).
KEYCLOAK_ADMIN_PASSWORD=

# --- Email ---------------------------------------------------------------------------------
# Where Lobby sends notification email, as an SMTP URL, for example
#   smtp://user:password@smtp.example.com:587
#   smtps://user:password@smtp.example.com:465
# Empty means email is written to the worker log instead of being sent.
# The demo points this at the bundled mail catcher: smtp://mailpit:1025 (open http://localhost:4125).
SMTP_URL=
MAIL_FROM=Lobby <lobby@localhost>

# --- Identity provider (optional) ------------------------------------------------------------
# Normally you connect your identity provider in the setup wizard and these stay empty.
# Set them to configure sign-in without the wizard; settings saved in the wizard take priority.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only when Lobby must reach the provider on a different address than browsers do
# (for example a provider running in the same Docker network). Leave empty otherwise.
OIDC_DISCOVERY_URL=

# --- AI assistant (optional) -------------------------------------------------------------------
# An Anthropic API key. You can also enter it under Admin, AI, where it is stored encrypted.
# A key saved in Admin takes priority over this one. Without any key the assistant answers
# with search results only.
ANTHROPIC_API_KEY=

# --- Demo only -------------------------------------------------------------------------------
# How the Lobby containers reach the demo identity provider on the Docker network.
# Read only by the demo seed. Browsers keep using http://localhost:4180/realms/northwind.
DEMO_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/northwind
