{
  "name": "@lobby/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../web/.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "reindex": "tsx --env-file-if-exists=../web/.env.local src/reindex.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lobby/ai": "workspace:*",
    "@lobby/connectors": "workspace:*",
    "@lobby/core": "workspace:*",
    "@lobby/db": "workspace:*",
    "pg-boss": "12.38.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": { "@types/node": "^24", "typescript": "5.9.3", "vitest": "5.0.4" }
}
