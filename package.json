{
  "name": "lobby",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "db:push": "pnpm --filter @lobby/db push",
    "db:seed": "pnpm --filter @lobby/db seed",
    "db:reset": "pnpm --filter @lobby/db reset",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "^3.6.2",
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  }
}
